PORT=4000
NODE_ENV=development
JWT_SECRET=bsdk_clubs_dev_jwt_secret_change_in_prod
JWT_REFRESH_SECRET=bsdk_clubs_dev_refresh_secret_change_in_prod
CLIENT_ORIGIN=*

